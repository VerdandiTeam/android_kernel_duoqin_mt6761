# config fragment for Duoqin F21 Pro expected to be applied on top of k61v1_64_bsp_defconfig

# devicetree
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE_NAMES="mediatek/mt6761"
CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE=y
CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE_NAMES="mediatek/f21pro"

# display panel
CONFIG_CUSTOM_KERNEL_LCM="nt35695B_fhd_dsi_vdo_auo_rt5081"
CONFIG_LCM_WIDTH="480"
CONFIG_LCM_HEIGHT="640"
# CONFIG_MTK_LCM_PHYSICAL_ROTATION_HW is not set

# touchscreen (FIXME: likely unused and enabling causes kernel panic, we seem to need mtk k4.19 driver+firmware for gsl3680 anyway)
# CONFIG_TOUCHSCREEN_MTK_GT1151 is not set

# camera (FIXME: "sp5508_mipi_raw sp2507_mipi_raw" entirely missing from drivers/misc/mediatek/imgsensor/src/common/v1 atm)
CONFIG_CUSTOM_KERNEL_IMGSENSOR=""

# keypad backlight
CONFIG_MT6370_PMU_RGBLED=y

# keypad top-left "Voice key" button (NOTE: stock somehow didn't enable this but it still worked?!)
CONFIG_KEYBOARD_GPIO=y

# headphones (USB-C)
CONFIG_SND_SOC_MT6357_ACCDET=y

# sensors (not present)
# CONFIG_CUSTOM_KERNEL_ACCELEROMETER is not set
# CONFIG_CUSTOM_KERNEL_BAROMETER is not set
# CONFIG_CUSTOM_KERNEL_GMRV_SENSOR is not set
# CONFIG_CUSTOM_KERNEL_GRAVITY_SENSOR is not set
# CONFIG_CUSTOM_KERNEL_GRV_SENSOR is not set
# CONFIG_CUSTOM_KERNEL_LINEARACCEL_SENSOR is not set
# CONFIG_CUSTOM_KERNEL_MAGNETOMETER is not set
# CONFIG_CUSTOM_KERNEL_RV_SENSOR is not set
# CONFIG_CUSTOM_KERNEL_SITUATION is not set
# CONFIG_CUSTOM_KERNEL_STEP_COUNTER is not set
# CONFIG_CUSTOM_KERNEL_UNCALI_MAG_SENSOR is not set

# modem (ulwg)
CONFIG_MTK_MD1_SUPPORT=9

# misc
CONFIG_LOG_BUF_SHIFT=22

# custom extras
# CONFIG_MTK_ACCELHUB is not set
# CONFIG_MTK_MAGHUB is not set
# CONFIG_MTK_BAROHUB is not set
# CONFIG_MTK_STEPSIGNHUB is not set
# CONFIG_MTK_STATHUB is not set
# CONFIG_MTK_WAKEHUB is not set
# CONFIG_MTK_GLGHUB is not set
# CONFIG_MTK_PICKUPHUB is not set
# CONFIG_MTK_DEVICE_ORIENTATION_HUB is not set
# CONFIG_MTK_TILTDETECTHUB is not set
# CONFIG_ARM64_ERRATUM_1542419 is not set

# maybe consider after wmt_drv etc connectivity /vendor/lib/modules built from source (when ABI breaks ok)
#CONFIG_NR_CPUS=4
#CONFIG_LTO_CLANG=y
#CONFIG_LTO_CLANG_THIN=y

# uart
#CONFIG_SERIAL_OF_PLATFORM=y

# earlyfb (cmdline: earlycon=simplefb,0x7faa0000,480,640)
CONFIG_FB_EARLY=y

# simplefb (NOTE: conflicts with LCM driver somewhat, cmdline: console=tty1 + simple-framebuffer dts node)
#CONFIG_FB_SIMPLE=y
#CONFIG_VT=y
#CONFIG_FRAMEBUFFER_CONSOLE=y

# systemd / core
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS4_FS=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SYSVIPC=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# CONFIG_SYSFS_DEPRECATED is not set
# CONFIG_STATIC_USERMODEHELPER is not set
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH=""
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# VT is a hard requirement; fbcon stays off (conflicts with the MTK LCM driver)
CONFIG_VT=y
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# cgroups / namespaces
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PERF=y
CONFIG_BLK_CGROUP=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# quota
CONFIG_QUOTA=y
CONFIG_QUOTACTL=y
CONFIG_QFMT_V2=y
CONFIG_QUOTA_NETLINK_INTERFACE=y

# networking
# CONFIG_ANDROID_PARANOID_NETWORK is not set
# CONFIG_DUMMY is not set
CONFIG_UNIX=y
CONFIG_IPV6=y
CONFIG_TUN=y
CONFIG_INET_AH=y
CONFIG_INET_ESP=y
CONFIG_INET_IPCOMP=y
CONFIG_INET6_AH=y
CONFIG_INET6_ESP=y
CONFIG_NET_L3_MASTER_DEV=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_SECURITY=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP6_NF_MATCH_RPFILTER=y
CONFIG_NF_LOG_IPV4=y
CONFIG_NF_LOG_IPV6=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_L2TP=y
CONFIG_L2TP_IP=y
CONFIG_L2TP_V3=y
CONFIG_PPP=y
CONFIG_PPPOE=y
CONFIG_PPP_ASYNC=y
CONFIG_PPP_SYNC_TTY=y
CONFIG_PPP_FILTER=y
CONFIG_PPP_MULTILINK=y

# filesystems
CONFIG_NLS_UTF8=y

# USB gadget (RNDIS, NCM)
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_UNIX98_PTYS=y

# Hybris
CONFIG_LOCKD=y
CONFIG_CUSE=y
CONFIG_SECURITY_YAMA=y
CONFIG_SUNRPC_GSS=y
CONFIG_NFS_FS=y
CONFIG_BLK_DEV_NBD=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_SUNRPC=y
CONFIG_CIFS=y
CONFIG_ECRYPT_FS=y
CONFIG_LBDAF=y
CONFIG_ISO9660_FS=y
CONFIG_NETFILTER_XT_MATCH_NFACCT=y
CONFIG_BT_RFCOMM=y
CONFIG_NFS_V4_1=y
CONFIG_IP6_NF_MATCH_MH=y
CONFIG_NET_DROP_MONITOR=y
CONFIG_BT_HCIUART=y
CONFIG_SECURITY_YAMA_STACKED=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_ANDROID_LOW_MEMORY_KILLER=y
CONFIG_F2FS_FS=y
CONFIG_BT_HCIUART_H4=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_UDF_FS=y
CONFIG_BT_HCIVHCI=y
CONFIG_BTRFS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_NETFILTER_NETLINK_ACCT=y
CONFIG_NF_CONNTRACK_IPV6=y
CONFIG_NFS_ACL_SUPPORT=y
CONFIG_NETFILTER_XT_MATCH_DCCP=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_NFS_COMMON=y
CONFIG_WATCHDOG_NOWAYOUT=y
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=y
CONFIG_BT_BNEP=y
CONFIG_NFS_V3_ACL=y
CONFIG_BT_HIDP=y
CONFIG_NFS_USE_KERNEL_DNS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_NFS_V4=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_NFS_V3=y
CONFIG_LOCKD_V4=y
CONFIG_IP6_NF_MATCH_AH=y
